<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0"
    ExtensionBundleId="com.designhub.illustrator"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Design Hub"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.designhub.illustrator.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- ILST = Illustrator. v24 (2020) .. open-ended -->
      <Host Name="ILST" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.designhub.illustrator.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Design Hub</Menu>
          <Geometry>
            <Size>
              <Height>120</Height>
              <Width>240</Width>
            </Size>
            <MinSize>
              <Height>80</Height>
              <Width>200</Width>
            </MinSize>
            <MaxSize>
              <Height>400</Height>
              <Width>600</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
