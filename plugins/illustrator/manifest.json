{
  "id": "com.designhub.illustrator",
  "name": "Design Hub",
  "version": "1.0.0",
  "manifestVersion": 6,
  "host": [
    { "app": "ILST", "minVersion": "26.0.0" }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "Design Hub" },
      "minimumSize": { "width": 220, "height": 80 },
      "maximumSize": { "width": 600, "height": 400 },
      "preferredDockedSize": { "width": 220, "height": 120 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["ws://localhost:49152"]
    }
  }
}
