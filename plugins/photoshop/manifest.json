{
  "id": "com.designhub.photoshop",
  "name": "Design Hub",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 4,
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon@1x.png",
      "scale": [1],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon@2x.png",
      "scale": [2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
    }
  ],
  "host": {
    "app": "PS",
    "minVersion": "22.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": ["ws://localhost:49152"],
      "localFileSystem": "none"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "Design Hub" },
      "minimumSize": { "width": 200, "height": 100 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "icons": [
        {
          "width": 24,
          "height": 24,
          "path": "icons/icon@1x.png",
          "scale": [1],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
        },
        {
          "width": 48,
          "height": 48,
          "path": "icons/icon@2x.png",
          "scale": [2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
        }
      ]
    }
  ]
}
